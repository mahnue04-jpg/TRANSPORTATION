# ── Required ────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# ── Optional — AI modules ────────────────────────────────────────────────────
# Get your key at https://openweathermap.org/api
weather_api_key=

# ── Optional — Server ────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# Leave blank to allow all origins (development only — unsafe in production).
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# App version surfaced in health checks and logs
APP_VERSION=1.0.0

# ── Optional — Database ───────────────────────────────────────────────────────
# Absolute path to the SQLite database file.
# Default: /data/chat.db  (matches the Docker volume mount in docker-compose.yml)
DB_FILENAME=/data/chat.db

# ── Optional — Conversation ───────────────────────────────────────────────────
# Number of recent messages sent to OpenAI as context
MAX_HISTORY=10

# ── Platform — Auth ───────────────────────────────────────────────────────────
# 32-byte random secret for JWT signing. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-32-byte-random-secret-here

# Separate JWT runtime secret used by readiness checks and production config validation.
JWT_SECRET=your-32-byte-random-secret-here

# JWT access token lifetime (minutes). Default: 60
ACCESS_TOKEN_EXPIRE_MINUTES=60

# JWT refresh token lifetime (days). Default: 7
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Platform — Database ───────────────────────────────────────────────────────
# PostgreSQL connection string (leave unset to use SQLite)
# Format: postgresql://user:password@host:5432/amicor
DATABASE_URL=

# Connection pool sizing for production traffic
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Public URL for rider tracking links in SMS/email (no trailing slash)
AMICOR_PUBLIC_URL=https://your-app.onrender.com

# ── Platform Ops — Driver onboarding document storage ─────────────────────────
# Release tag surfaced in startup logs and /api/health/* (see backend/release.version).
# Override with APP_VERSION only when release.version is absent.
# local_dev (development only) | encrypted_private | s3_private
# Production fails closed unless encrypted_private or configured s3_private is set.
# Do not invent S3 credentials. s3_private is BLOCKED until bucket + keys exist.
PLATFORM_OPS_DOCUMENT_STORAGE=local_dev
PLATFORM_OPS_DOCUMENT_STORAGE_PATH=/data/onboarding_docs
PLATFORM_OPS_DOCUMENT_ENCRYPTION_KEY=
AMICOR_DOCUMENT_S3_BUCKET=
AMICOR_DOCUMENT_S3_REGION=
AMICOR_DOCUMENT_S3_ACCESS_KEY=
AMICOR_DOCUMENT_S3_SECRET_KEY=
# Optional S3-compatible HTTPS endpoint (Cloudflare R2). Absent = default AWS S3.
AMICOR_DOCUMENT_S3_ENDPOINT=
# Keep OFF. Do not enable live passenger dispatch or STS/MHCP in this phase.
AMICOR_APPROVAL_ENGINE_DISPATCH_GATE=0
AMICOR_STS_MHCP_DISPATCH_ENABLED=0

# ── Health ISF — Payments (Stripe) ────────────────────────────────────────────
HEALTH_ISF_STRIPE_ENABLED=0
# Minutes before scheduled pickup when reserved rides promote to Current Trip (default 60)
SCHEDULED_ROUTE_START_LEAD_MINUTES=60
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Ride + Deliver customer-payment webhook (separate Stripe destination from Connect).
STRIPE_PAYMENT_WEBHOOK_SECRET=

# ── Health ISF — Notifications (Twilio SMS) ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Platform — Rate limiting ──────────────────────────────────────────────────
# Auth endpoints: max requests per minute per IP (default 20)
RATE_LIMIT_AUTH=20

# Chat endpoints: max requests per minute per IP (default 60)
RATE_LIMIT_CHAT=60

# ── Platform — Postgres (docker-compose only) ─────────────────────────────────
POSTGRES_DB=amicor
POSTGRES_USER=amicor
POSTGRES_PASSWORD=change-me-in-production

# ── Ecosystem — Email OAuth / SMTP ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EMAIL_REDIRECT_URI=http://127.0.0.1:8000/app

OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common
OUTLOOK_EMAIL_REDIRECT_URI=http://127.0.0.1:8000/app

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ── Ecosystem — Calendar OAuth ────────────────────────────────────────────────
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/app
OUTLOOK_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/app

# ── Ecosystem — Search/Provider cache ─────────────────────────────────────────
SEARCH_CACHE_TTL=300
