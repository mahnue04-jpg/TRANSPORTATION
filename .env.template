# ── Required ────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# ── Optional — AI modules ────────────────────────────────────────────────────
# Get your key at https://openweathermap.org/api
weather_api_key=

# ── Optional — Server ────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# Leave blank to allow all origins (development only — unsafe in production).
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# App version surfaced in health checks and logs
APP_VERSION=1.0.0

# ── Optional — Database ───────────────────────────────────────────────────────
# Absolute path to the SQLite database file.
# Default: /data/chat.db  (matches the Docker volume mount in docker-compose.yml)
DB_FILENAME=/data/chat.db

# ── Optional — Conversation ───────────────────────────────────────────────────
# Number of recent messages sent to OpenAI as context
MAX_HISTORY=10
