{
  "name": "amicore",
  "version": "1.0.0",
  "description": "AI-powered tool runtime and orchestration system",
  "main": "backend/app/main.py",
  "scripts": {
    "dev:start": "powershell -ExecutionPolicy Bypass -File scripts/start_amicor_dev.ps1",
    "dev:start:no-browser": "powershell -ExecutionPolicy Bypass -File scripts/start_amicor_dev.ps1 -NoBrowser",
    "prod:start": "powershell -ExecutionPolicy Bypass -File scripts/start_amicor_prod.ps1",
    "prod:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop_amicor_prod.ps1",
    "prod:install-startup-task": "powershell -ExecutionPolicy Bypass -File scripts/install_amicor_startup_task.ps1",
    "prod:uninstall-startup-task": "powershell -ExecutionPolicy Bypass -File scripts/uninstall_amicor_startup_task.ps1",
    "validate:a4": ".venv\\Scripts\\python.exe backend\\scripts\\a4_operational_validation.py",
    "build": "node scripts/ci/build-check.js",
    "lint": "node scripts/ci/lint-check.js",
    "tsc": "node scripts/ci/tsc-check.js",
    "test:platform": "node backend/static/runPlatformTests.js",
    "test:database": "node backend/static/runDatabaseTests.js",
    "test:security": "node backend/static/runSecurityTests.js",
    "test:ecosystem": "node backend/static/runEcosystemTests.js",
    "test:integrations": "node backend/static/runIntegrationsTests.js",
    "benchmark:runtime": "node backend/static/runRuntimeBenchmarks.js",
    "test:tools": "node backend/static/runToolTests.js",
    "test:execution": "node backend/static/runToolExecutionTests.js",
    "test:realtools": "node backend/static/runRealToolTests.js",
    "benchmark:tools": "node backend/static/runToolBenchmarks.js",
    "test:memory": "node backend/static/runMemoryTests.js",
    "benchmark:memory": "node backend/static/runMemoryBenchmarks.js",
    "test:planning": "node backend/static/runPlanningTests.js",
    "benchmark:planning": "node backend/static/runPlanningBenchmarks.js",
    "test:assistant": "node backend/static/runAssistantTests.js",
    "test:routing": "node backend/static/runRoutingTests.js",
    "benchmark:assistant": "node backend/static/runAssistantBenchmarks.js",
    "test:conversation": "node backend/static/runConversationUiTests.js",
    "benchmark:conversation": "node backend/static/runConversationUiBenchmarks.js",
    "test:capabilities": "node backend/static/runCapabilitiesTests.js",
    "benchmark:capabilities": "node backend/static/runCapabilitiesBenchmarks.js",
    "test:auth": "node backend/static/runAuthTests.js",
    "benchmark:auth": "node backend/static/runAuthBenchmarks.js",
    "test:deployment": "node backend/static/runDeploymentTests.js",
    "test:ux": "node backend/static/runUXTests.js",
    "benchmark:deployment": "node backend/static/deploymentBenchmarks/index.js",
    "benchmark:frontend": "node backend/static/runFrontendBenchmarks.js",
    "deployment:preflight": "node backend/static/scripts/deploymentPreflightCli.js",
    "test:runtime": "node backend/static/runToolTests.js",
    "test:production": "node backend/static/runProductionTests.js",
    "test:mvp": "node backend/static/runMVPTests.js",
    "test:voice": "node backend/static/runVoiceTests.js",
    "test:capabilities-live": "node backend/static/runCapabilitiesLiveTests.js",
    "test:runtime-live": "node backend/static/runRuntimeLiveTests.js",
    "test:localhost-live": "node backend/static/runLiveLocalhostIntegrationTests.js",
    "test:continuity-soak": "node scripts/soak/continuity_soak_watchdog.mjs",
    "test:continuity-soak:recover": "powershell -NoProfile -Command \"$env:AMICOR_SOAK_MINUTES='10'; node scripts/soak/continuity_soak_watchdog.mjs\"",
    "test:multimodal": "node backend/static/runMultimodalTests.js",
    "test:resilience": "node backend/static/runResilienceTests.js",
    "benchmark:providers": "node backend/static/runProviderBenchmarks.js",
    "test:responses": "node backend/static/runResponseNormalizationTests.js",
    "test": "npm run test:tools"
  },
  "keywords": [
    "runtime",
    "tools",
    "execution",
    "orchestration"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "typescript": "^6.0.3"
  }
}
